  "scripts": {
    "build": "nest build",
    "format": "prettier --write \"src/**/*.ts\" \"test/**/*.ts\"",
    "start": "nest start",
    "dev": "NODE_OPTIONS=--dns-result-order=ipv4first nest start --watch",
    "start:debug": "NODE_OPTIONS=--dns-result-order=ipv4first nest start --debug --watch",
    "start:prod": "NODE_OPTIONS=--dns-result-order=ipv4first node dist/main",
    "lint": "eslint \"{src,apps,libs,test}/**/*.ts\" --fix",
    "plans:seed": "TS_NODE_PROJECT=tsconfig.seed.json node --env-file=.env -r ts-node/register src/database/seeders/plans.seeder.ts",
    "fresh:seed": "TS_NODE_PROJECT=tsconfig.seed.json node --env-file=.env -r ts-node/register src/database/seeders/fresh-seed.ts",
    "plans:seed:prod": "node dist/database/seeders/plans.seeder.js",
    "fresh:seed:prod": "node dist/database/seeders/fresh-seed.js"
  },
  "dependencies": {
    "@aws-sdk/client-s3": "^3.1038.0",
    "@aws-sdk/lib-storage": "^3.1038.0",
