NODE_ENV=development
PORT=3001

# Credentials for the /api/docs sign-in page (also accepted as HTTP Basic by
# curl and CI). REQUIRED in every environment — the app refuses to boot without
# them. DOCS_PASSWORD must be at least 8 characters.
DOCS_USER=docs
DOCS_PASSWORD=change-me-locally

DB_HOST=db
DB_PORT=5432
DB_NAME=busybrains
DB_USER=busybrains
DB_PASSWORD=changeme

CLERK_SECRET_KEY=sk_xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx
CLERK_WEBHOOK_SECRET=whsec_xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx

STRIPE_PUBLISHABLE_KEY=pk_xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx
STRIPE_SECRET_KEY=sk_xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx
STRIPE_WEBHOOK_SECRET=whsec_xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx

STRIPE_PRICE_SOLO=xxx
STRIPE_PRICE_FAMILY=xxx
STRIPE_PRICE_UPGRADE=xxx

AWS_REGION=xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx
AWS_ACCESS_KEY_ID=xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx
AWS_SECRET_ACCESS_KEY=xxxxxxxxxxxxxxxxxxxxxxxxxxxx
AWS_S3_BUCKET=xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx



KIT_API_KEY=xxxx-xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx
# Get these from Kit → Send → Sequences
KIT_PURCHASE_COMPLETION_SEQUENCE_ID=xxxxx
KIT_MODULE1_COMPLETION_SEQUENCE_ID=xxxxx
KIT_ACCOUNT_DELETION_OTP_SEQUENCE_ID=xxxxx
KIT_CHILD_DELETION_OTP_SEQUENCE_ID=xxxxx
KIT_FEEDBACK_REPORT_SEQUENCE_ID=xxxxx
KIT_CHILD_FEEDBACK_REPORT_SEQUENCE_ID=xxxxx
# Inbox that feedback report emails (parent + child) are sent to.
KIT_REPORTS_TO=hello@busy-brains.com.au

START_TRIAL_ON_SIGNUP=true

GOOGLE_CLIENT_ID=xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx
GOOGLE_CLIENT_SECRET=xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx
BACKEND_URL=https://api.busy-brains.com.au
FRONTEND_URL=https://busy-brains.com.au

COMPOSE_PROJECT_NAME=busy-brains-backend
PUPPETEER_EXECUTABLE_PATH=/usr/bin/chromium-browser

# Comma-separated emails, e.g. a@x.com,b@y.com — grants free bypass of
# payment/time module gates. Empty in this example; set real addresses only
# in the server's own .env (never commit them).
FREE_ACCESS_EMAILS=
# Comma-separated emails granted an instant (no-delay) module 2 unlock, for
# users confirmed to have paid before the staggered unlock schedule shipped.
MODULE2_INSTANT_UNLOCK_EMAILS=


